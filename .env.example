# ─── AI Provider ─────────────────────────────────────────────────────────────
#
# Groq (recommended for local dev)
#   Free tier — generous rate limits, no credit card required.
#   Get your key at https://console.groq.com
#
GROQ_API_KEY=

# Vercel AI Gateway (recommended for production)
#   Multi-provider routing with observability and model fallbacks.
#   On Vercel deployments this is auto-provided via OIDC — no key needed.
#   Get your key at https://vercel.com/dashboard → AI tab
#
AI_GATEWAY_API_KEY=

# Direct OpenAI (optional — for openai/* model ids)
OPENAI_API_KEY=

# ─── Model Selection ─────────────────────────────────────────────────────────
#
# Triage + retrieval planning (fast + cheap)
SANDIGAN_MODEL_TRIAGE=groq/llama-3.3-70b-versatile

# Legal answer generation (strongest model you have access to)
#
#   Groq free tier:
#     groq/llama-3.3-70b-versatile    ← default, solid legal reasoning
#
#   Via AI Gateway (requires Vercel account):
#     anthropic/claude-sonnet-4-6     ← best legal reasoning + Taglish
#     openai/gpt-4o                   ← strong alternative
#
SANDIGAN_MODEL_ANSWER=groq/llama-3.3-70b-versatile

# ─── Real-time Web Search (SerpAPI) ───────────────────────────────────────────
#
# Enables the enrichment stage:
#   • Live minimum wage lookups from nwpc.dole.gov.ph
#   • Recent DOLE advisories and Department Orders
#
# Get your key at https://serpapi.com (free tier: 100 searches/month)
#
SERPAPI_API_KEY=
