# ─── LLM Provider ────────────────────────────────────────────────────────────
#
# Groq — free tier, fast inference, generous daily limits.
# Get your key at https://console.groq.com
#
GROQ_API_KEY=

# ─── Embeddings ───────────────────────────────────────────────────────────────
#
# HuggingFace Inference API — used by LangChain to embed the legal corpus
# and user queries for semantic search. Free tier is enough.
# Get your key at https://huggingface.co/settings/tokens
#
HUGGINGFACE_API_KEY=

# ─── Model Selection (optional overrides) ────────────────────────────────────
#
# Both default to llama-3.3-70b-versatile if not set.
#
SANDIGAN_MODEL_TRIAGE=groq/llama-3.3-70b-versatile
SANDIGAN_MODEL_ANSWER=groq/llama-3.3-70b-versatile

# ─── Real-time Web Search ────────────────────────────────────────────────────
#
# SerpAPI — used by the enrichment stage for live minimum wage lookups and
# recent DOLE advisories. Free tier: 100 searches/month.
# Get your key at https://serpapi.com
#
SERPAPI_API_KEY=
